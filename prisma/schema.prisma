generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Store {
  id        String                @id
  name      String
  city      String
  type      String                // flagship / mall / outlet
  sales     DailyInventorySales[]
}

model Product {
  sku          String                @id
  name         String
  category     String                // e.g. sneakers, loafers, sandals, boots, slip-ons
  costPrice    Float
  sellingPrice Float
  sales        DailyInventorySales[]
}

model DailyInventorySales {
  id            Int      @id @default(autoincrement())
  date          DateTime
  storeId       String
  sku           String
  openingStock  Int
  unitsReceived Int
  unitsSold     Int
  closingStock  Int

  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [sku], references: [sku], onDelete: Cascade)

  @@unique([date, storeId, sku])
}
